# /etc/zymple/zymple.yml. Every key is optional; these are the defaults,
# except "backup", which is off until configured.

listen: 127.0.0.1:7080            # must be loopback; Caddy is the public listener
socket: /run/zymple/zymple.sock   # operator API, root only
apps_dir: /etc/zymple/apps
state_dir: /var/lib/zymple

caddy:
  snippets_dir: /etc/caddy/zymple
  reload: ["systemctl", "reload", "caddy"]
  tls: auto                       # auto | internal | off

containerd:
  socket: /run/containerd/containerd.sock
  namespace: moby

ports: { low: 20000, high: 29999 }  # loopback ports for web containers

# backup:
#   type: s3                      # or "posix" with path: /mnt/backups
#   path: prod                    # key prefix inside the bucket
#   cipher_pass: change-me        # encrypts the repository; required for Redis
#   s3:
#     endpoint: s3.example.com
#     bucket: backups
#     region: eu
#     access_key: ...
#     secret_key: ...
#     path_style: true

# postgres_images: { 17: ghcr.io/gokaykucuk/zymple-postgres:17 }
# The defaults for these two are pinned by digest in the binary. Override
# them to move to a newer version before a Zymple release does.
# redis_image: redis:7.4.12-alpine@sha256:7f7d30b7fdd09467bac58198a1f166dd69789d348d4fe859cccb20e0cf287fbe
# restic_image: restic/restic:0.17.3@sha256:8f5a62b422a2cb1277ea0dd6e826fe1acf649e5b9f02d60e5268d5fd1976255a
